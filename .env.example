# Landlord Hub — environment variables

# Neon Postgres (pooled — use for app runtime on Vercel)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (use for drizzle-kit migrations only)
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# App URL (used by Auth.js redirects)
AUTH_URL="http://localhost:3000"

# Email (optional — for lease renewal reminders)
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"

# File uploads — local storage path (relative to project root)
UPLOAD_DIR="./public/uploads"

# SPEI bank details (shown to tenants on /portal/payments)
# SPEI_CLABE="012345678901234567"
# SPEI_BENEFICIARY="PlayaStays Properties SA de CV"
# SPEI_BANK="BBVA"
