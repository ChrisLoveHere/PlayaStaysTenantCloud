# Landlord Hub — environment variables

# Database (SQLite for local dev — file is created automatically)
DATABASE_URL="file:./local.db"

# For production PostgreSQL (future):
# DATABASE_URL="postgresql://user:password@host:5432/landlord_hub"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# App URL (used by Auth.js redirects)
AUTH_URL="http://localhost:3000"

# Email (optional — for lease renewal reminders)
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"

# File uploads — local storage path (relative to project root)
UPLOAD_DIR="./public/uploads"
